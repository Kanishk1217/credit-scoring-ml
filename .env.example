# Copy to .env and fill in. NEVER commit .env (it holds real keys).
CREDIT_ENVIRONMENT=development            # or "production"
CREDIT_API_KEYS=changeme_key1,changeme_key2   # comma-separated valid API keys
CREDIT_ALLOWED_ORIGINS=["https://your-frontend.example.com"]
CREDIT_RATE_LIMIT=30/minute
CREDIT_ENABLE_DOCS=true                    # set false in production
