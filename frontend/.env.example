# Copy to .env.local and fill in. NEVER commit .env.local (it can hold real keys).

# Dev proxy target (see vite.config.ts) -- forwards /api/* to your local FastAPI backend.
API_TARGET=http://localhost:8077
API_KEY=changeme_dev_key   # must match one of CREDIT_API_KEYS on the backend

# Supabase project (Settings -> API in your Supabase dashboard). The anon key is safe to ship
# client-side -- Supabase's Row Level Security enforces access, not this key. Leave both unset
# to run without accounts (login pages show a "not configured" message, dashboards stay reachable
# only once you enable it).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# To enable "Continue with Google":
#   1. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
#      (Web application). Add your Supabase callback URL as an authorized redirect URI:
#      https://<your-project-ref>.supabase.co/auth/v1/callback
#   2. Supabase Dashboard -> Authentication -> Providers -> Google -> paste the Client ID/Secret.
#   3. Supabase Dashboard -> Authentication -> URL Configuration -> add your site URLs
#      (http://localhost:5173, https://credit-scoring-ml.pages.dev) to Redirect URLs.
